{
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "activity-calendar",
  "publisher": "bhojanibilal24",
  "name": "Activity Calendar",
  "version": "0.2.0",
  "description": "A sidebar activity calendar for Codex and Claude: work blocks, parallel agents, Orca thread names, work recaps, and CSV timesheets. Reads local history, and can show a paired Orca host's own calendar through Orca; no external service.",
  "license": "MIT",
  "repository": "https://github.com/bhojanibilal24/orca-activity-calendar",
  "engines": { "orca": ">=1.4.246" },
  "pluginApi": 1,
  "main": "src/worker.mjs",
  "contributes": {
    "panels": [
      { "id": "calendar", "title": "Activity Calendar", "icon": "calendar", "entry": "web/panel.html", "ui": "html" }
    ],
    "commands": [
      { "id": "calendar.refresh", "title": "Activity Calendar: Refresh History", "when": "global" }
    ],
    "events": [{ "on": "agent.status.changed" }]
  },
  "capabilities": [{ "kind": "agent:read" }, { "kind": "storage:own" }]
}
